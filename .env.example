# Copy to .env and fill in from the Supabase project dashboard (Settings → API).
# .env is gitignored; only this example is committed.

# Client-safe. Bundled into the app (VITE_ prefix). RLS is what protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY by `npm run test:rls` to create/tear down test users.
# NEVER expose this to the client and never commit it — it bypasses RLS.
# Leave unset unless you are running the RLS integration test.
SUPABASE_SERVICE_ROLE_KEY=
